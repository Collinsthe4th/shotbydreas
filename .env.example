# Copy to .env for local development (npm run dev). On Vercel, add these under
# Project Settings > Environment Variables. Never commit the real .env.

# Dreas's WhatsApp number in international format, digits only.
WHATSAPP_NUMBER=2348136078551

# Google service account that can see Dreas's calendar free/busy (see README).
GOOGLE_SERVICE_ACCOUNT_EMAIL=booking-site@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON key file, including the BEGIN/END lines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The calendar's ID. For his main calendar this is his Gmail address.
GOOGLE_CALENDAR_ID=dreas@gmail.com

# Optional (defaults shown)
BOOKING_TIMEZONE=Africa/Lagos
BOOKING_WINDOW_DAYS=180
BOOKING_MIN_NOTICE_DAYS=2
BOOKING_MAX_DATES=5
